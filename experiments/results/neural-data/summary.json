{
  "dataset": "PhysioNet/Computing in Cardiology Challenge 2019 v1.0.0",
  "coverage_threshold": 0.05,
  "delta_clip_hours": 24,
  "time_scale_hours": 72,
  "selected_variables": [
    "HR",
    "O2Sat",
    "Temp",
    "SBP",
    "MAP",
    "DBP",
    "Resp",
    "BaseExcess",
    "HCO3",
    "FiO2",
    "pH",
    "PaCO2",
    "SaO2",
    "BUN",
    "Chloride",
    "Creatinine",
    "Glucose",
    "Magnesium",
    "Phosphate",
    "Potassium",
    "Hct",
    "Hgb",
    "WBC",
    "Platelets"
  ],
  "splits": [
    {
      "split": "train",
      "patients": 14247,
      "patient_hours": 554538,
      "variables": 24,
      "output": "experiments/results/neural-data/train.npz"
    },
    {
      "split": "validation",
      "patients": 3015,
      "patient_hours": 117666,
      "variables": 24,
      "output": "experiments/results/neural-data/validation.npz"
    },
    {
      "split": "internal_test",
      "patients": 3074,
      "patient_hours": 118011,
      "variables": 24,
      "output": "experiments/results/neural-data/internal_test.npz"
    },
    {
      "split": "external_calibration",
      "patients": 2069,
      "patient_hours": 77534,
      "variables": 24,
      "output": "experiments/results/neural-data/external_calibration.npz"
    },
    {
      "split": "external_test",
      "patients": 17931,
      "patient_hours": 684461,
      "variables": 24,
      "output": "experiments/results/neural-data/external_test.npz"
    }
  ],
  "leakage_boundary": "Variable selection, medians, IQRs, clipping statistics, and all normalization parameters were fit on cohort-A training patients only."
}
